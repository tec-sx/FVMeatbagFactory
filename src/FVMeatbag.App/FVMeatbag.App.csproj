<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>FVMeatbag.App</RootNamespace>
    <AssemblyName>FVMeatbagFactory</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Avalonia's XAML compiler generates code the analyzers flag. -->
    <NoWarn>$(NoWarn);CA1515</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\FVMeatbag.Graph\FVMeatbag.Graph.csproj" />
    <ProjectReference Include="..\FVMeatbag.Core\FVMeatbag.Core.csproj" />
    <ProjectReference Include="..\FVMeatbag.Scene\FVMeatbag.Scene.csproj" />
    <ProjectReference Include="..\FVMeatbag.Rendering.Vulkan\FVMeatbag.Rendering.Vulkan.csproj" />
  </ItemGroup>
</Project>
