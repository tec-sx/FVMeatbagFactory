<Project Sdk="Microsoft.NET.Sdk">
  <!-- Vulkan backend on Silk.NET. -->
  <PropertyGroup>
    <RootNamespace>FVMeatbag.Rendering.Vulkan</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Silk.NET.Vulkan" />
    <PackageReference Include="Silk.NET.Vulkan.Extensions.KHR" />
    <PackageReference Include="Silk.NET.Vulkan.Extensions.EXT" />
  </ItemGroup>
  <ItemGroup>
    <!-- Compiled from the .vert/.frag sources next to them; see Shaders/README.md. -->
    <EmbeddedResource Include="Shaders\*.spv" LogicalName="FVMeatbag.Rendering.Vulkan.Shaders.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="FVMeatbag.Rendering.Vulkan.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\FVMeatbag.Rendering\FVMeatbag.Rendering.csproj" />
  </ItemGroup>
</Project>
